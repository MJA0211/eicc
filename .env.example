EICC_DATABASE_URL=sqlite:///./eicc.db
EICC_DEMO_MODE=true
EICC_SECURE_COOKIES=false
EICC_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
# Set these privately to bootstrap an authenticated administrator.
# EICC_ADMIN_EMAIL=
# EICC_ADMIN_PASSWORD=
# Docker requires EICC_POSTGRES_PASSWORD in your untracked .env.
